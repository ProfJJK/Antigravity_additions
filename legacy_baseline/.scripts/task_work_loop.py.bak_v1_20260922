# ── Core task processor ───────────────────────────────────────────────────────

async def process_task(task_file, state):
    # Encoding fallback: old pipeline files may be cp1252 (written without encoding=)
    # Try UTF-8 first (new files), fall back to cp1252 (legacy files), then replace on failure
    plan = None
    for _enc in ("utf-8", "utf-8-sig", "cp1252"):
        try:
            with open(task_file, "r", encoding=_enc) as f:
                plan = json.load(f)
            break
        except (UnicodeDecodeError, json.JSONDecodeError):
            continue
    if plan is None:
        with open(task_file, "r", encoding="utf-8", errors="replace") as f:
            plan = json.load(f)

    # Bug fix: use task_id from JSON plan, not fragile filename split
    task_id    = plan.get("task_id", os.path.splitext(os.path.basename(task_file))[0])
    agent_name = plan.get("agent_name", "cochem-coder")
    prompt     = plan.get("prompt", "")
    logger.info(f"Assigning to {agent_name} (provider={os.environ.get('DEFAULT_LLM_PROVIDER', 'gemini')})...")

    try:
        exec_text = await safe_chat_cli(agent_name, prompt)
        if not exec_text:
            raise ValueError("Execution agent returned empty response.")
    except Exception as e:
        logger.error(f"Task {task_id} execution failed: {e}")
        # Activate Pivot Council
        pivoted = await trigger_pivot_council(task_file, str(e), task_id)
        return pivoted  # if True, a new task was queued — the loop will pick it up

    failure_trace_acc = []

    for cycle in range(1, MAX_CYCLES + 1):
        logger.info(f"Cycle {cycle}: Auditing output...")

        native_spoofing_flag = False
        native_critique = ""

        # Gather physical file contents that the agent claims to have modified
        physical_contents = []
        modified_files = []
        # Attempt to parse ExecutionResult from exec_text
        try:
            exec_data_raw = json.loads(exec_text) if exec_text.strip().startswith("{") else {}
            modified_files = exec_data_raw.get("modified_files", [])
        except Exception:
            pass

        for filepath in modified_files[:20]:  # cap at 20 files to avoid token overflow
            if not os.path.exists(filepath):
                break
            try:
                with open(filepath, "r", encoding="utf-8") as f:
                    physical_contents.append(f"--- FILE: {filepath} ---\n{f.read()}\n")
            except Exception as e:
                physical_contents.append(f"--- FILE: {filepath} (COULD NOT BE READ: {e}) ---\n")

        if native_spoofing_flag:
            logger.error(f"NATIVE SPOOFING DETECTED: {native_critique}")
            await run_agent_council(native_critique, task_id, state)
            break

        disk_dump = "\n".join(physical_contents)

        audit_prompt = f"""
Audit the execution output against the ORIGINAL TASK INSTRUCTIONS.

ORIGINAL TASK INSTRUCTIONS GIVEN TO AGENT:
{prompt}

Below is the exact physical contents of the files the agent claims to have modified, extracted directly from the disk by the Python orchestrator.
If the agent faked the work or failed to create the files, set status to 'SPOOFING_DETECTED'.
If the agent output stub code, or if there are bugs or incomplete features, set status to 'FAIL' and detail what needs to be fixed.
If the physical files completely fulfill the task instructions flawlessly, set to 'PASS'.

Execution Agent Summary:
{exec_text[:3000]}

Physical Disk Contents:
{disk_dump[:8000]}
"""
        try:
            audit_data = await safe_chat_cli("cochem-audit", audit_prompt, extract_type="structured", pydantic_model=AuditResult)
        except Exception as e:
            logger.error(f"Task {task_id} audit failed: {e}")
            return False

        if not audit_data:
            logger.warning("Auditor failed to return structured data. Treating as FAIL.")
            status, critique = "FAIL", "Auditor output was malformed."
        else:
            status  = getattr(audit_data, "status", "FAIL").upper()
            critique = getattr(audit_data, "critique", "")

        if status == "SPOOFING_DETECTED":
            await run_agent_council(critique, task_id, state)
            break

        if status == "PASS":
            logger.info("Audit passed!")
            return True

        logger.info(f"Auditor found issues (Status: {status}). Sending back for revision.")
        failure_trace_acc.append(f"Cycle {cycle}: {critique}")
        correction_prompt = (
            f"The auditor found the following issues. Please perform actual work to fix them. "
            f"You MUST output an updated ExecutionResult detailing ALL the files you modified.\n"
            f"Auditor Feedback:\n{critique}"
        )
        try:
            exec_text = await safe_chat_cli(agent_name, correction_prompt)
            if not exec_text:
                raise ValueError("Execution agent failed to return response on revision.")
        except Exception as e:
            logger.error(f"Task {task_id} revision failed: {e}")
            failure_trace_acc.append(str(e))
            break

    # All cycles exhausted — activate Pivot Council
    logger.warning(f"Task {task_id} reached max cycles without PASS. Activating Pivot Council.")
    combined_trace = "\n".join(failure_trace_acc)
    pivoted = await trigger_pivot_council(task_file, combined_trace, task_id)
    return pivoted


# ── State helpers ─────────────────────────────────────────────────────────────

def load_state():
    if os.path.exists(STATE_FILE):
        with open(STATE_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    return {"completed_tasks": []}

def save_state(state):
    tmp_file = STATE_FILE + ".tmp"
    with open(tmp_file, "w", encoding="utf-8") as f:
        json.dump(state, f, indent=4)
    if os.path.exists(STATE_FILE):
        os.remove(STATE_FILE)
    os.rename(tmp_file, STATE_FILE)


# ── Main loop ─────────────────────────────────────────────────────────────────

async def _run_with_hw_semaphore(task_file: str, state: dict) -> bool:
    """Wrap process_task in the hardware-adaptive semaphore slot.
    Matches the old Gemini pipeline pattern: grab a slot, run, release."""
    global _active_worker_count
    sem = _worker_semaphore if _worker_semaphore is not None else asyncio.Semaphore(1)
    async with sem:
        _active_worker_count += 1
        try:
            return await process_task(task_file, state)
        finally:
            _active_worker_count -= 1


async def main():
    Path(PROMPTS_DIR).mkdir(parents=True, exist_ok=True)

    # Initial hardware poll — sets worker semaphore before first task
    _refresh_worker_semaphore()
    logger.info(
        f"Starting Kanban Task Work Loop daemon. "
        f"provider={os.environ.get('DEFAULT_LLM_PROVIDER', 'gemini')} "
        f"workers={_current_worker_limit}/{_HW_CEIL}"
    )

    _last_hw_poll = 0.0

    while True:
        # Re-poll hardware every _HW_POLL_INTERVAL seconds and resize semaphore
        now = time.monotonic()
        if now - _last_hw_poll >= _HW_POLL_INTERVAL:
            _refresh_worker_semaphore()
            _last_hw_poll = now

        # Bug fix: match ALL .json files, not just *_prompt.json
        # Skip internal state/trace files by name pattern
        _skip_suffixes = ("_failure_trace.txt", "_state.json")
        _skip_prefixes = ("work_loop_state",)
        prompt_files = [
            f for f in glob.glob(os.path.join(PROMPTS_DIR, "*.json"))
            if not any(os.path.basename(f).startswith(p) for p in _skip_prefixes)
            and not any(os.path.basename(f).endswith(s) for s in _skip_suffixes)
        ]

        def sort_key(f):
            # Read priority from JSON if available — PRIORITY_N files go first (tier 0)
            try:
                for _enc in ("utf-8", "utf-8-sig", "cp1252"):
                    try:
                        plan = json.loads(open(f, encoding=_enc).read())
                        break
                    except (UnicodeDecodeError, json.JSONDecodeError):
                        plan = {}
                # Explicit numeric priority field wins
                if "priority" in plan:
                    return [int(plan["priority"])]
            except Exception:
                pass
            base = os.path.basename(f)
            # Files starting with PRIORITY_ get tier 0
            if base.upper().startswith("PRIORITY_"):
                try:
                    n = int(base.split("_")[1])
                    return [0, n]
                except Exception:
                    return [0, 0]
            # Numeric prefix like 1.1_prompt.json → [1, 1]
            stem = base.split("_")[0]
            try:
                return [1] + [int(p) for p in stem.split(".")]
            except Exception:
                return [9999]

        prompt_files.sort(key=sort_key)

        state = load_state()
        completed = set(state.get("completed_tasks", []))

        tasks_processed = False

        # Collect pending (not yet completed) tasks and launch up to worker limit concurrently
        pending = []
        for task_file in prompt_files:
            # Bug fix: use task_id from JSON content, not fragile filename split
            try:
                _plan_peek = json.loads(open(task_file, encoding="utf-8").read())
                task_id = _plan_peek.get("task_id", os.path.splitext(os.path.basename(task_file))[0])
            except Exception:
                task_id = os.path.splitext(os.path.basename(task_file))[0]

            if task_id in completed:
                continue

            pending.append((task_file, task_id))

        if pending:
            tasks_processed = True
            # Graduated ramp-up: launch _RAMP_STEP tasks per step, then wait half a poll
            # interval and re-poll hardware so psutil sees the load from the claude.exe
            # processes that were just spawned before any more are added.
            # Ceiling is still hardware-derived (<= COCHEM_MAX_CONCURRENT_PROCESSES).
            queue = list(pending)
            running: list = []
            meta: dict = {}
            while queue:
                in_flight = max(_active_worker_count, sum(1 for t in running if not t.done()))
                slots = min(_RAMP_STEP, len(queue), max(0, _current_worker_limit - in_flight))
                for _ in range(slots):
                    task_file, task_id = queue.pop(0)
                    state["active_task"] = task_id
                    save_state(state)
                    t = asyncio.create_task(_run_with_hw_semaphore(task_file, state))
                    running.append(t)
                    meta[t] = (task_file, task_id)
                if slots > 0:
                    logger.info(
                        f"[RAMP] +{slots} workers "
                        f"(in-flight≈{in_flight + slots}/{_current_worker_limit}, queued={len(queue)})"
                    )
                # Wait half a poll interval so new processes register on CPU/RAM
                await asyncio.sleep(_HW_POLL_INTERVAL / 2)
                _refresh_worker_semaphore()
                if _active_worker_count >= _current_worker_limit and queue:
                    # At ceiling — wait for a slot to free before adding more
                    await asyncio.sleep(5)

            results = await asyncio.gather(*running, return_exceptions=True)

            for t, result in zip(running, results):
                task_file, task_id = meta[t]
                if isinstance(result, Exception):
                    logger.error(f"Task {task_id} raised: {result}")
                    result = False
                if result:
                    state = load_state()
                    completed = set(state.get("completed_tasks", []))
                    completed.add(task_id)
                    state["completed_tasks"] = list(completed)
                    save_state(state)
                else:
                    logger.error(f"Task {task_id} failed to complete gracefully. Sleeping before retry.")


        if tasks_processed:
            await asyncio.sleep(5)
        else:
            if os.path.exists(STATE_FILE):
                os.remove(STATE_FILE)
            await asyncio.sleep(15)


if __name__ == "__main__":
    asyncio.run(main())
