{
  "iptables": false,
  "live-restore": true,
  "storage-driver": "overlay2",
  "bridge": "none",
  "log-opts": {
    "max-file": "3",
    "max-size": "10m"
  },
  "default-ulimits": {
    "nproc": {
      "Hard": 512,
      "Soft": 512,
      "Name": "nproc"
    },
    "nofile": {
      "Hard": 65536,
      "Soft": 65536,
      "Name": "nofile"
    }
  },
  "log-driver": "json-file"
}
